# Frontend env — copy to .env.local and adjust.
#
# Local dev: leave as /api. next.config.ts rewrites /api/* to the Nest process
# (default http://127.0.0.1:5000, override with API_PROXY_TARGET).
NEXT_PUBLIC_API_URL=/api

# Production (Vercel): point directly at the deployed API, e.g.
# NEXT_PUBLIC_API_URL=https://your-service.onrender.com/api

# Dev-only: where next.config.ts proxies /api/* during `npm run dev`.
# API_PROXY_TARGET=http://127.0.0.1:5000
